    {
      "id": "w04-09",
      "title": "Check each event before it is posted",
      "type": "practice",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Every required event has a traceable ID.",
            "Account names match the chart of accounts.",
            "Accounts and timing fit the evidence.",
            "Debits equal credits for each event."
          ]
        }
      ],
      "lead": "Exit check: can a balanced journal entry still be wrong?",
      "notes": "Supports Milestone 1. Correct the source record before preparing later summaries.",
      "answer": {
        "blocks": [
          {
            "type": "text",
            "text": "Yes. An equipment purchase recorded as Rent Expense and Cash balances, but it uses the wrong debit account."
          }
        ]
      }
