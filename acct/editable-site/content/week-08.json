    {
      "id": "w08-07",
      "title": "Diagnose an error that still balances",
      "type": "practice",
      "blocks": [
        {
          "type": "text",
          "text": "Suppose the $2,000 equipment purchase was recorded as Rent Expense and Cash."
        }
      ],
      "lead": "Would the trial balance agree? What would be misleading?",
      "answer": {
        "blocks": [
          {
            "type": "bullets",
            "items": [
              "The totals still agree.",
              "Equipment is understated by $2,000.",
              "Expenses are overstated and net income understated by $2,000."
            ]
          }
        ]
      }
    },
    {
      "id": "w08-08",
      "title": "Explain a correction to a classmate",
      "type": "concept",
      "blocks": [
        {
          "type": "sequence",
          "items": [
            {
              "heading": "Evidence",
              "text": "The invoice identifies equipment."
            },
            {
              "heading": "Correction",
              "text": "Move the $2,000 debit from Rent Expense to Equipment."
            },
            {
              "heading": "Propagation",
              "text": "Refresh the ledger, trial balance, and reports."
            }
          ]
        },
        {
          "type": "table",
