  "slides": [
    {
      "id": "w08-01",
      "title": "Retrieve the rules without looking at the chart",
      "type": "opener",
      "blocks": [
        {
          "type": "bullets",
          "items": [
            "Which accounts normally increase with a debit?",
            "Does receivable collection create new revenue?",
            "Can a balanced trial balance still be wrong?"
          ]
        }
      ],
      "notes": "Two minutes individually, then pairs. This lecture can fit around a midterm without removing new prerequisites.",
      "answer": {
        "blocks": [
          {
            "type": "bullets",
            "items": [
              "Assets, expenses, and dividends increase with debits.",
              "Collection exchanges a receivable for cash.",
              "Omissions, duplicates, and wrong accounts can preserve equality."
            ]
          }
        ]
      }
    },
    {
