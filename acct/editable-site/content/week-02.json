    {
      "id": "w02-09",
      "title": "Check accounts, direction, amounts, and balance",
      "type": "practice",
      "blocks": [
        {
          "type": "sequence",
          "items": [
            {
              "heading": "Identify",
              "text": "Name each account."
            },
            {
              "heading": "Classify",
              "text": "Find its type."
            },
            {
              "heading": "Analyze",
              "text": "Choose increase or decrease."
            },
            {
              "heading": "Record",
              "text": "Choose debit or credit; check equality."
            }
          ]
        }
      ],
      "lead": "Exit check: does collecting a receivable create revenue again?",
      "answer": {
        "blocks": [
          {
            "type": "table",
