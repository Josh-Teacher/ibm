{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accounting lecture content",
  "description": "Plain-text lecture data. _comment fields are safe private editing notes. Keep existing IDs stable for links.",
  "type": "object",
  "required": [
    "id",
    "week",
    "title",
    "slides"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "week": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "_comment": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "text"
            },
            "_comment": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "bullets"
            },
            "_comment": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "text"
          ],
          "properties": {
            "type": {
              "const": "equation"
            },
            "_comment": {
              "type": "string"
            },
            "text": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "label",
            "numerator",
            "denominator"
          ],
          "properties": {
            "type": {
              "const": "fraction"
            },
            "_comment": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "numerator": {
              "type": "string"
            },
            "denominator": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "columns",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "table"
            },
            "_comment": {
              "type": "string"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rows": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "cells"
                    ],
                    "properties": {
                      "cells": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "null"
                          ]
                        }
                      },
                      "kind": {
                        "enum": [
                          "total",
                          "subtotal",
                          "section",
                          "indent",
                          ""
                        ]
                      }
                    }
                  }
                ]
              }
            },
            "note": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "tables"
          ],
          "properties": {
            "type": {
              "const": "splitTables"
            },
            "_comment": {
              "type": "string"
            },
            "tables": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "type",
                  "columns",
                  "rows"
                ],
                "properties": {
                  "type": {
                    "const": "table"
                  },
                  "_comment": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "oneOf": [
                        {
                          "type": "array",
                          "items": {
                            "type": [
                              "string",
                              "number",
                              "null"
                            ]
                          }
                        },
                        {
                          "type": "object",
                          "required": [
                            "cells"
                          ],
                          "properties": {
                            "cells": {
                              "type": "array",
                              "items": {
                                "type": [
                                  "string",
                                  "number",
                                  "null"
                                ]
                              }
                            },
                            "kind": {
                              "enum": [
                                "total",
                                "subtotal",
                                "section",
                                "indent",
                                ""
                              ]
                            }
                          }
                        }
                      ]
                    }
                  },
                  "note": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "company",
            "title",
            "period",
            "rows"
          ],
          "properties": {
            "type": {
              "const": "statement"
            },
            "_comment": {
              "type": "string"
            },
            "company": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "period": {
              "type": "string"
            },
            "rows": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ]
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "cells"
                    ],
                    "properties": {
                      "cells": {
                        "type": "array",
                        "items": {
                          "type": [
                            "string",
                            "number",
                            "null"
                          ]
                        }
                      },
                      "kind": {
                        "enum": [
                          "total",
                          "subtotal",
                          "section",
                          "indent",
                          ""
                        ]
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "accounts"
          ],
          "properties": {
            "type": {
              "const": "taccounts"
            },
            "_comment": {
              "type": "string"
            },
            "accounts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "debits",
                  "credits"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "debits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "credits": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "balance": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "compare"
            },
            "_comment": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "heading",
                  "text"
                ],
                "properties": {
                  "heading": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items"
          ],
          "properties": {
            "type": {
              "const": "sequence"
            },
            "_comment": {
              "type": "string"
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "heading",
                  "text"
                ],
                "properties": {
                  "heading": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "slide": {
      "type": "object",
      "required": [
        "id",
        "title",
        "blocks"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "enum": [
            "opener",
            "concept",
            "practice"
          ]
        },
        "lead": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "takeaway": {
          "type": "string"
        },
        "notes": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "_comment": {
          "type": "string"
        },
        "answer": {
          "type": "object",
          "required": [
            "blocks"
          ],
          "properties": {
            "blocks": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/block"
              }
            },
            "takeaway": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
